---
interface Props {
	class?: string;
	width?: number;
}
const { class: className = '', width = 320 } = Astro.props;
---

<svg
	class:list={['brain-motif', className]}
	width={width}
	viewBox="0 0 200 160"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<defs>
		<linearGradient id="brainStroke" x1="10" y1="10" x2="190" y2="150" gradientUnits="userSpaceOnUse">
			<stop offset="0%" stop-color="#e34989" />
			<stop offset="55%" stop-color="#ffadc6" />
			<stop offset="100%" stop-color="#a98360" />
		</linearGradient>
	</defs>

	<path
		class="brain-outline"
		d="M100,20 C70,10 40,25 30,50 C15,55 10,75 20,90 C15,100 20,115 35,120 C35,135 55,145 75,140 C85,150 105,150 115,140 C130,145 150,135 150,115 C165,105 165,85 155,72 C165,60 160,40 145,32 C140,15 115,12 100,20 Z"
		stroke="url(#brainStroke)"
		stroke-width="2.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	></path>

	<g class="brain-folds" stroke="url(#brainStroke)" stroke-width="1.6" stroke-linecap="round" opacity="0.8">
		<path d="M100,20 C95,50 98,90 92,140" />
		<path d="M50,55 C60,50 70,60 65,70 C75,75 70,90 60,88" />
		<path d="M90,40 C100,35 110,45 105,55 C115,60 110,75 100,72" />
		<path d="M120,55 C130,50 140,60 135,72 C145,78 138,92 128,90" />
		<path d="M58,100 C68,98 80,105 76,115" />
		<path d="M100,95 C112,92 122,100 118,112" />
	</g>

	<g class="brain-sparks" fill="#e34989">
		<circle cx="65" cy="70" r="2.4" />
		<circle cx="105" cy="55" r="2.2" />
		<circle cx="135" cy="72" r="2.2" />
		<circle cx="78" cy="115" r="2" />
		<circle cx="118" cy="112" r="2" />
	</g>
</svg>

<style>
	.brain-motif {
		height: auto;
		overflow: visible;
	}
	.brain-outline,
	.brain-folds path {
		stroke-dasharray: 900;
		stroke-dashoffset: 900;
		animation: draw 2.8s ease-out forwards;
	}
	.brain-folds path {
		animation-delay: 0.4s;
	}
	.brain-sparks circle {
		opacity: 0;
		transform-origin: center;
		animation: spark 2.4s ease-in-out infinite;
		animation-delay: 2.6s;
	}
	.brain-sparks circle:nth-child(2) {
		animation-delay: 3s;
	}
	.brain-sparks circle:nth-child(3) {
		animation-delay: 3.4s;
	}
	.brain-sparks circle:nth-child(4) {
		animation-delay: 3.8s;
	}
	.brain-sparks circle:nth-child(5) {
		animation-delay: 4.2s;
	}

	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes spark {
		0%,
		100% {
			opacity: 0.25;
			transform: scale(0.85);
		}
		50% {
			opacity: 1;
			transform: scale(1.3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brain-outline,
		.brain-folds path {
			animation: none;
			stroke-dashoffset: 0;
		}
		.brain-sparks circle {
			animation: none;
			opacity: 0.7;
		}
	}
</style>
