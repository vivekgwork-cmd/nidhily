---
import SectionDivider from './SectionDivider.astro';
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<SectionDivider />
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 0 1.5em 4em 1.5em;
		text-align: center;
	}
	footer p {
		color: var(--muted);
		font-size: 0.9em;
		margin: 0;
	}
</style>
