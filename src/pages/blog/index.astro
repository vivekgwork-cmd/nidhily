---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/react/PostList';
import Reveal from '../../components/react/Reveal';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		href: `/blog/${post.id}/`,
		title: post.data.title,
		date: post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }),
		thumb: post.data.heroImage,
	}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 900px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<Reveal client:load as="div">
				<h1 class="gradient-text">Blog</h1>
			</Reveal>
			{posts.length === 0 ? <p>No posts yet — check back soon!</p> : <PostList client:visible posts={posts} />}
		</main>
		<Footer />
	</body>
</html>
