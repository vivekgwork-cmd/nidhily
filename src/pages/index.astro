---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import portrait from '../assets/shrinidhi-portrait.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const home = await getEntry('pages', 'home');
const { Content } = home ? await render(home) : { Content: null };

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 3rem;
				flex-wrap: wrap;
			}
			.hero-portrait {
				flex: 0 0 auto;
			}
			.hero-portrait img {
				width: 220px;
				height: 220px;
				object-fit: cover;
				border-radius: 50%;
				box-shadow: var(--box-shadow);
			}
			.hero-text {
				flex: 1 1 320px;
			}
			.hero-text h1 {
				margin-bottom: 0.25em;
			}
			.tagline {
				color: var(--accent-dark);
				font-size: 1.25em;
				font-weight: 700;
				margin-bottom: 1em;
			}
			.latest {
				margin-top: 4rem;
			}
			.latest h2 {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.5em;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				margin-bottom: 1.5em;
			}
			.post-list a {
				text-decoration: none;
				font-size: 1.25em;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.post-list a:hover {
				color: var(--accent);
			}
			.post-list .date {
				display: block;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.view-all {
				display: inline-block;
				margin-top: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-portrait">
					<Image src={portrait} width={220} height={220} alt={SITE_TITLE} />
				</div>
				<div class="hero-text">
					<h1>{SITE_TITLE}</h1>
					{home?.data.tagline && <p class="tagline">{home.data.tagline}</p>}
					{Content && <Content />}
				</div>
			</section>

			<section class="latest">
				<h2>Latest posts</h2>
				{
					posts.length === 0 ? (
						<p>No posts yet — check back soon!</p>
					) : (
						<ul class="post-list">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					)
				}
				<a class="view-all" href="/blog">Read all posts &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
