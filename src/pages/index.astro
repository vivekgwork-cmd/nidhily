---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import portrait from '../assets/shrinidhi-portrait.png';
import BaseHead from '../components/BaseHead.astro';
import BrainMotif from '../components/BrainMotif.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const home = await getEntry('pages', 'home');
const { Content } = home ? await render(home) : { Content: null };

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 3.5rem;
				flex-wrap: wrap;
				padding-top: 1.5rem;
			}
			.hero-portrait {
				flex: 0 0 auto;
				position: relative;
				width: 260px;
			}
			.aura {
				position: absolute;
				inset: -30%;
				background: radial-gradient(closest-side, rgba(227, 73, 137, 0.35), rgba(255, 173, 198, 0.2) 55%, transparent 75%);
				filter: blur(6px);
				z-index: 0;
			}
			.hero-portrait :global(img) {
				position: relative;
				z-index: 1;
				width: 100%;
				height: auto;
				mask-image: radial-gradient(ellipse 62% 68% at 50% 45%, black 55%, transparent 100%);
				-webkit-mask-image: radial-gradient(ellipse 62% 68% at 50% 45%, black 55%, transparent 100%);
			}
			.brain-accent {
				position: absolute;
				bottom: -2.5rem;
				right: -3.5rem;
				width: 120px;
				z-index: 2;
				opacity: 0.9;
			}
			.hero-text {
				flex: 1 1 340px;
			}
			.hero-text h1 {
				margin-bottom: 0.2em;
			}
			.tagline {
				font-family: var(--font-serif);
				font-style: italic;
				color: var(--muted);
				font-size: 1.3em;
				margin-bottom: 1em;
			}
			.latest h2 {
				margin-bottom: 1em;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				padding: 1.5em 0;
				border-bottom: 1px solid rgba(var(--brown-tan-rgb), 0.25);
			}
			.post-list li:first-child {
				padding-top: 0;
			}
			.post-list li:last-child {
				border-bottom: none;
			}
			.post-list a {
				text-decoration: none;
				display: block;
				font-family: var(--font-serif);
				font-size: 1.5em;
				font-weight: 600;
				color: var(--ink);
				background-image: none;
				transition: background-position 0.4s ease;
			}
			.post-list a:hover {
				background: var(--gradient-brand);
				background-size: 200% auto;
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.post-list .date {
				display: block;
				color: var(--muted);
				font-size: 0.85em;
				margin-top: 0.25em;
			}
			.view-all {
				display: inline-block;
				margin-top: 1.5em;
				font-family: var(--font-serif);
				font-style: italic;
			}
			@media (max-width: 640px) {
				.hero {
					gap: 2rem;
				}
				.hero-portrait {
					width: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" data-reveal>
				<div class="hero-portrait">
					<div class="aura"></div>
					<Image src={portrait} width={320} height={320} alt={SITE_TITLE} />
					<div class="brain-accent"><BrainMotif width={120} /></div>
				</div>
				<div class="hero-text">
					<h1 class="gradient-text">{SITE_TITLE}</h1>
					{home?.data.tagline && <p class="tagline">{home.data.tagline}</p>}
					{Content && <Content />}
				</div>
			</section>

			<SectionDivider />

			<section class="latest" data-reveal>
				<h2>Latest posts</h2>
				{
					posts.length === 0 ? (
						<p>No posts yet — check back soon!</p>
					) : (
						<ul class="post-list">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					)
				}
				<a class="view-all" href="/blog">Read all posts &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
