---
import { getImage } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import portraitSrc from '../assets/shrinidhi-portrait.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroIntro from '../components/react/HeroIntro';
import Portrait from '../components/react/Portrait';
import PostList from '../components/react/PostList';
import Reveal from '../components/react/Reveal';
import SectionDivider from '../components/SectionDivider.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const home = await getEntry('pages', 'home');
const { Content } = home ? await render(home) : { Content: null };

const portrait = await getImage({ src: portraitSrc, width: 640 });

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)
	.map((post) => ({
		href: `/blog/${post.id}/`,
		title: post.data.title,
		date: post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }),
	}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 3.5rem;
				flex-wrap: wrap;
				padding-top: 1.5rem;
			}
			.hero-portrait {
				flex: 0 0 auto;
				width: 280px;
			}
			.hero-text {
				flex: 1 1 340px;
			}
			.latest h2 {
				margin-bottom: 1.25em;
			}
			.view-all {
				display: inline-block;
				margin-top: 1.5em;
				font-weight: 600;
			}
			@media (max-width: 640px) {
				.hero {
					gap: 2rem;
				}
				.hero-portrait {
					width: 220px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-portrait">
					<Portrait client:load src={portrait.src} width={640} height={780} alt={SITE_TITLE} />
				</div>
				<div class="hero-text">
					<HeroIntro client:load title={SITE_TITLE} tagline={home?.data.tagline} />
					<Reveal client:visible delay={0.15}>
						{Content && <Content />}
					</Reveal>
				</div>
			</section>

			<SectionDivider />

			<section class="latest">
				<Reveal client:visible as="div">
					<h2>Latest posts</h2>
				</Reveal>
				{
					posts.length === 0 ? (
						<p>No posts yet — check back soon!</p>
					) : (
						<PostList client:visible posts={posts} compact />
					)
				}
				<a class="view-all" href="/blog">Read all posts &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
