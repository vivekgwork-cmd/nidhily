---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AnimatedBrain from '../components/react/AnimatedBrain';
import Reveal from '../components/react/Reveal';
import { SITE_TITLE } from '../consts';

const about = await getEntry('pages', 'about');
const { Content } = about ? await render(about) : { Content: null };
const heading = about?.data.heading ?? 'About Me';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${heading} | ${SITE_TITLE}`} description={heading} />
		<style>
			.about-hero {
				position: relative;
			}
			.watermark {
				position: absolute;
				top: -2rem;
				right: -3rem;
				width: 220px;
				opacity: 0.16;
				z-index: -1;
			}
			h1 {
				margin-bottom: 1.5rem;
			}
			.prose {
				max-width: 720px;
			}
			.prose :global(h2) {
				margin-top: 1.8em;
				font-size: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-hero">
				<div class="watermark">
					<AnimatedBrain client:visible width={220} />
				</div>
				<Reveal client:load>
					<h1 class="gradient-text">{heading}</h1>
					<div class="prose">{Content && <Content />}</div>
				</Reveal>
			</div>
		</main>
		<Footer />
	</body>
</html>
